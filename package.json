{
  "name": "b5w-private-stage1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply b5w-private --local",
    "db:remote": "wrangler d1 migrations apply b5w-private --remote"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pixi.js": "^8.0.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
